{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=ncut_market;User=root;Password=;"
  },
  "Jwt": {
    "Issuer": "ncut-market",
    "Audience": "ncut-market",
    "ExpireMinutes": 10080
