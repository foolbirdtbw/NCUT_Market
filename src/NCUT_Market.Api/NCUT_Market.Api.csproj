<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Emit XML documentation so the summaries and <param> tags on the controllers and DTOs reach the
      generated OpenAPI document. Microsoft.AspNetCore.OpenApi's targets collect the .xml files of
      ProjectReferences as AdditionalFiles, which is the mechanism that carries the comments from
      NCUT_Market.Core across the project boundary.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- See the note in NCUT_Market.Core.csproj: CS1591 is suppressed as recoverable tech debt. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCUT_Market.Core\NCUT_Market.Core.csproj" />
    <ProjectReference Include="..\NCUT_Market.Infrastructure\NCUT_Market.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Version matches the Microsoft.AspNetCore.App shared framework exactly (10.0.11). It is not part
      of that framework, so it has to come from a package. Neither this nor Scalar.AspNetCore depends
      on EntityFrameworkCore or Pomelo, so the EF Core 9.0.19 pin is structurally unaffected.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

</Project>
