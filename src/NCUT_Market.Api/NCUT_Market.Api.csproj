<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Emit XML documentation so the summaries and <param> tags on the controllers and DTOs reach the
      generated OpenAPI document. Microsoft.AspNetCore.OpenApi's targets collect the .xml files of
      ProjectReferences as AdditionalFiles, which is the mechanism that carries the comments from
      NCUT_Market.Core across the project boundary.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- See the note in NCUT_Market.Core.csproj: CS1591 is suppressed as recoverable tech debt. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The frontend lives at the repository root, outside this project, so the Web SDK's wwwroot
      convention does not see it and nothing would copy it into a publish output. These items are
      what put it there, as web/ in the output — which is the third candidate StaticWebRoot tries.

      This is only needed for publish. Under `dotnet run` the content root is the project directory
      and StaticWebRoot's second candidate (`../../web`) resolves the same files straight from the
      source tree, so CopyToOutputDirectory is deliberately not set: copying them into bin/ as well
      would just be a second, staler copy that nothing reads.

      None rather than Content. Content is the static-web-assets pipeline's item type, and these
      files are served by an explicit PhysicalFileProvider rather than by the wwwroot conventions
      that pipeline implements. None means "copy this file and otherwise leave it alone", which is
      exactly the requirement.

      RecursiveDir keeps the directory shape, so web/css/site.css publishes as web/css/site.css
      rather than being flattened into one directory — which would break every relative URL in
      index.html. PreserveNewest keeps an incremental publish from rewriting all of it every time.

      The consequence to remember: a file added under web/ is picked up here automatically, but a
      file added *outside* these globs works in development and 404s in production. That is what the
      dotnet publish step in the verification checklist exists to catch.
    -->
    <None Include="..\..\web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NCUT_Market.Core\NCUT_Market.Core.csproj" />
    <ProjectReference Include="..\NCUT_Market.Infrastructure\NCUT_Market.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Version matches the Microsoft.AspNetCore.App shared framework exactly (10.0.11). It is not part
      of that framework, so it has to come from a package. Neither this nor Scalar.AspNetCore depends
      on EntityFrameworkCore or Pomelo, so the EF Core 9.0.19 pin is structurally unaffected.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.10" />
  </ItemGroup>

</Project>
