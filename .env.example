# Copy to .env for local development. Never commit the populated .env file.
#
# A double underscore becomes a configuration separator, so the line below binds to
# ConnectionStrings:DefaultConnection — which is what GetConnectionString("DefaultConnection") reads.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=ncut_market;User=root;Password=replace-me;

# Binds to ASPNETCORE_ENVIRONMENT. Without it, `dotnet run` with no --launch-profile starts in
# Production, where the OpenAPI document and Scalar UI are deliberately not mapped.
Environment=Development

# Binds to Jwt:SigningKey. Required — the API refuses to start without it, because signing tokens
# with an empty key produces tokens anyone can forge, and that failure is invisible from the
# outside. Generate one with:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))   # quick, NOT cryptographically safe
#   openssl rand -base64 48                                          # prefer this
# Hs256 requires at least 32 bytes of key material.
Jwt__SigningKey=replace-me-with-at-least-32-bytes-of-random-data

# Optional. Where uploaded product images are written. Defaults to <content-root>/data/uploads,
# which resolves correctly under both `dotnet run` (the project directory) and `dotnet publish`
# (the publish output), so it normally does not need setting.
# Storage__UploadRoot=D:\path\to\uploads

# Optional. Credentials for the listing assistant ("AI 帮我看一下" on the publish page).
# Leaving the key unset does NOT stop the app from starting — the assistant button just answers
# "暂时用不了" and publishing is unaffected. Both the key and the model name are needed for the
# assistant to work at all; the model must accept images.
# BaseUrl defaults to https://api.deepseek.com/v1. Any OpenAI-compatible provider works by
# changing these two values — the code does not know or care which vendor it is talking to.
# Ai__ApiKey=replace-me
# Ai__Model=replace-me
# Ai__BaseUrl=https://api.deepseek.com/v1
