bin/
obj/
# out/ is build output you can delete, with one exception: the frontend checks are source that
# happens to live there. They are re-included below so a fresh clone can still run them. The
# pattern has to be out/* and not out/ — git never descends into an excluded directory, so a
# negation under a plain out/ would silently do nothing.
out/*
!out/check-frontend.js
.vs/
.vscode/
*.user
*.suo

appsettings.Development.local.json
.env
*.log

# Uploaded product images and their generated sizes. Runtime data, not source: it is written by
# the running API under the content root, which is the project directory during `dotnet run`.
src/NCUT_Market.Api/data/

TestResults/
coverage*.json
coverage*.xml

# Written by db/seed-demo.ps1 — it lists the generated demo accounts, which are throwaway
# local rows, not something a clone should inherit.
db/demo-accounts.txt

# Deployment scripts and the systemd unit, written for our own server. They hard-code that one
# machine's paths, service name and upload dir, so they are not something a clone should
# inherit — and the live server is driven by hand now, which leaves them unmaintained.
deploy/
